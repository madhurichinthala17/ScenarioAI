# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# ── LLM Provider ───────────────────────────────────────────────────────────
# Choose one block and comment out the other

# Option A: Local Ollama (default — no API key needed)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5
LLM_TEMPERATURE=0.0

# Option B: OpenAI API (required for GitHub Actions — runners can't reach local Ollama)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.0
# OPENAI_API_KEY=sk-...

# ── Pipeline ───────────────────────────────────────────────────────────────
MAX_RETRIES=2
OUTPUT_DIR=generated_tests

# ── LangSmith tracing  ────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=scenarioai
