# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

LLM_MODEL=qwen2.5
LLM_TEMPERATURE=0.0
MAX_RETRIES=2
OUTPUT_DIR=generated_tests

# LangSmith tracing (optional — get a free key at smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=scenarioai
